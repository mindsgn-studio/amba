APP_ENV=development

# SQLite location (relative paths resolve against the project root)
DATABASE_URL=sqlite:///./data/app.db

# Where generated books/audio/timings live
DATA_DIR=./data

# TTS engine: kokoro | fake (fake = silent test engine, no models needed)
TTS_PROVIDER=kokoro

# Kokoro voices: af_heart, af_bella, am_adam, bf_emma, ...
TTS_VOICE=af_heart
TTS_SPEED=1.0

# Final audio format: mp3 (requires ffmpeg) | wav
AUDIO_FORMAT=mp3

# Chunk sizing (words)
CHUNK_TARGET_WORDS=800
CHUNK_MAX_WORDS=1500

API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO

WORKER_POLL_SECONDS=1.0
