{
  "name": "read-along",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest tests/unit tests/integration",
    "test:components": "jest tests/components",
    "test:e2e": "maestro test .maestro",
    "test:e2e:backend": "node tools/mock-backend.mjs",
    "db:generate": "drizzle-kit generate && node tools/build-migrations.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:components"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.7",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-speech": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.6",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
