{
  "expo": {
    "name": "AMBA",
    "slug": "amba",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "amba",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["assets/*"],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      },
      "bundleIdentifier": "mindsgn.studio.test"
    },
    "android": {
      "package": "mindsgn.studio.test"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-document-picker",
        {
          "iCloudContainerInfo": {}
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
