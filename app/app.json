{
  "expo": {
    "name": "Read Along",
    "slug": "read-along",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "readalong",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["assets/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      },
      "bundleIdentifier": "com.readalong.app"
    },
    "android": {
      "package": "com.readalong.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-document-picker",
        {
          "iCloudContainerInfo": {}
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
